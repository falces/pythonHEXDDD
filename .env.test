# Environment variables for testing
FLASK_ENV=testing
DEBUG=False

# Database (SQLite en memoria para tests)
DB_ENGINE=sqlite
SQLALCHEMY_DATABASE_URI=sqlite:///:memory:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_INTERNAL_PORT=3306
MYSQL_DATABASE=test_db
MYSQL_USER=test_user
MYSQL_PASSWORD=test_password
SERVICE_NAME=test_service

# API Keys (valores dummy para tests)
STREAM_AVAILABILITY_HOST=https://api.test.com
STREAM_AVAILABILITY_KEY=test_api_key_12345

# Logging
LOG_LEVEL=ERROR
